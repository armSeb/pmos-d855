# Reference: <https://postmarketos.org/devicepkg>
# Remplace l'ancien port downstream (noyau 3.4) par le noyau mainline du dépôt.
pkgname=device-lg-d855
pkgdesc="LG G3 (International)"
pkgver=3
pkgrel=18
url="https://github.com/armSeb/pmos-d855"
license="MIT"
arch="armv7"
options="!check !archcheck"
# Outils de bring-up : bus I2C (i2c-tools), GPIO (libgpiod), entrées
# (evtest), USB (usbutils), WiFi (iw, wpa_supplicant), BT (bluez),
# traçage (strace).
depends="
	linux-lg-d855
	mkbootimg
	postmarketos-base
	evtest
	i2c-tools
	bluez
	iw
	libgpiod
	strace
	usbutils
	wpa_supplicant
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	devmem32.c
	mdp-dump.sh
	extract-firmware.sh
	lk2nd-flash-boot
	lk2nd-flash-boot.service
	lk2nd-flash-boot.path
	mmcc-trace.sh
	mdss-snapshot.sh
	modprobe-lg-d855.conf
	modules-load-lg-d855.conf
	"

build() {
	devicepkg_build $startdir $pkgname
	# lecture/écriture de registres (tools/devmem32 du dépôt)
	${CC:-gcc} $CFLAGS -Wall -o devmem32 "$srcdir"/devmem32.c $LDFLAGS
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 devmem32 "$pkgdir"/usr/bin/devmem32
	install -Dm755 "$srcdir"/mdp-dump.sh "$pkgdir"/usr/bin/mdp-dump
	install -Dm755 "$srcdir"/extract-firmware.sh "$pkgdir"/usr/bin/extract-firmware
	install -Dm755 "$srcdir"/mmcc-trace.sh "$pkgdir"/usr/bin/mmcc-trace
	install -Dm755 "$srcdir"/mdss-snapshot.sh "$pkgdir"/usr/bin/mdss-snapshot
	install -Dm644 "$srcdir"/modprobe-lg-d855.conf "$pkgdir"/etc/modprobe.d/lg-d855.conf
	install -Dm644 "$srcdir"/modules-load-lg-d855.conf "$pkgdir"/etc/modules-load.d/lg-d855.conf

	# Secours si lk2nd ne lit pas la microSD : recopie /boot/boot.img
	# derrière lk2nd (désactivé par défaut, voir README).
	install -Dm755 "$srcdir"/lk2nd-flash-boot "$pkgdir"/usr/sbin/lk2nd-flash-boot
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/lk2nd-flash-boot.service "$srcdir"/lk2nd-flash-boot.path
}

# Sommes générées par : pmbootstrap checksum device-lg-d855
sha512sums=""
