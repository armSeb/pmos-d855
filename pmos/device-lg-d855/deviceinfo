# Reference: https://wiki.postmarketos.org/wiki/Deviceinfo_reference
# Port mainline (linux-lg-d855, fork msm8974-mainline) démarré via lk2nd.
# Les offsets sont ceux de lk2nd-msm8974 ; à recouper avec device-oneplus-bacon.

deviceinfo_format_version="0"
deviceinfo_name="LG G3 (International)"
deviceinfo_manufacturer="LG"
deviceinfo_codename="lg-d855"
deviceinfo_year="2014"
# sur ARM, dtbs_install installe les DTB à plat dans /boot/dtbs (ARCH_WANT_FLAT_DTB_INSTALL)
deviceinfo_dtb="qcom-msm8974pro-lge-d855"
deviceinfo_arch="armv7"

# Device related
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1440"
deviceinfo_screen_height="2560"
deviceinfo_getty="ttyMSM0;115200"

# Provisoire, tant qu'il n'y a pas de driver d'affichage : sans ces options,
# Linux coupe les horloges et régulateurs « inutilisés », le MDSS arrête de
# rafraîchir le panel alors que ses alimentations (DSV, GPIO 56/100) restent
# allumées → écran rose et rémanence. À retirer quand le panel sera géré.
# initcall_blacklist=mmcc_msm8974_driver_init : au démarrage, le driver
# d'horloges multimédia casse l'affichage hérité du bootloader dans la première
# seconde (écran bleu ; isolé par élimination, et ce n'est pas seulement la
# reprogrammation des MMPLL, cf. patch 0004). Rien d'actif n'en dépend tant que
# MDSS, GPU et vidéo sont désactivés. À retirer pour le GPU.
deviceinfo_kernel_cmdline="clk_ignore_unused pd_ignore_unused regulator_ignore_unused initcall_blacklist=mmcc_msm8974_driver_init"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_append_dtb="true"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_pagesize="2048"
# lk2nd (avec tools/lk2nd/*.patch : microSD activée) lit
# /boot/extlinux/extlinux.conf sur la carte : rien à flasher à chaque mise
# à jour du noyau. Le boot.img reste généré pour fastboot boot.
deviceinfo_generate_extlinux_config="true"
deviceinfo_flash_sparse="true"
