# Fragment appliqué sur msm8974_defconfig (fork msm8974-mainline) pour produire
# config-lg-d855.armv7 (voir pmos/README.md). Régénérer la config complète
# après modification : pmos/make-config.sh

CONFIG_LOCALVERSION="-lg-d855"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Démarrage : lk2nd charge boot.img (zImage + DTB appendé) ---
CONFIG_ARM_APPENDED_DTB=y
CONFIG_BLK_DEV_INITRD=y

# --- Exigences postmarketOS (pmbootstrap kconfig check) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_UEVENT_HELPER=n
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- Rootfs sur microSD : stockage en dur, pas de module dans l'initramfs ---
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y

# --- Réseau USB pour le debug (pmos.debug-shell) ---
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# --- Périphériques propres au G3 ---
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_F12=y
CONFIG_CHARGER_BQ24190=y
CONFIG_BATTERY_MAX17040=m
# Rétroéclairage LM3697 exposé comme backlight via led-backlight
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_LM3697=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_LED=m
# Alimentation +/- du panel
CONFIG_REGULATOR_TPS65132=m
