# Fragment appliqué sur msm8974_defconfig (fork msm8974-mainline) pour produire
# config-lg-d855.armv7 (voir pmos/README.md). Régénérer la config complète
# après modification : pmos/make-config.sh

CONFIG_LOCALVERSION="-lg-d855"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Démarrage : lk2nd charge boot.img (zImage + DTB appendé) ---
CONFIG_ARM_APPENDED_DTB=y
CONFIG_BLK_DEV_INITRD=y

# --- Exigences postmarketOS (pmbootstrap kconfig check) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_UEVENT_HELPER=n
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- Rootfs sur microSD : stockage en dur, pas de module dans l'initramfs ---
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y

# --- Réseau USB pour le debug (pmos.debug-shell) ---
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# --- Périphériques propres au G3 ---
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_F12=y
CONFIG_CHARGER_BQ24190=y
CONFIG_BATTERY_MAX17040=m
# Rétroéclairage LM3697 exposé comme backlight via led-backlight
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_LM3697=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_LED=m
# Alimentation +/- du panel
CONFIG_REGULATOR_TPS65132=m
# Panel LGD SIC double DSI (patch 0002) ; inutilisé tant que MDP5 ne gère
# pas le DSI couplé
CONFIG_DRM_PANEL_LGE_G3_LGD_SIC=m
# Affichage via le framebuffer du bootloader (simple-framebuffer)
CONFIG_DRM_SIMPLEDRM=y

# mmcc-msm8974 intégré : sa sonde ne casse plus l'affichage hérité (patch
# 0004), et simpledrm doit pouvoir tenir le GDSC et les horloges MDSS dès le
# démarrage (DTS, nœud framebuffer) sans attendre un module.
CONFIG_MSM_MMCC_8974=y
# GCC n'était built-in que par le select de MMCC : indispensable au boot
CONFIG_MSM_GCC_8974=y
# DVFS du GPU Adreno 330 : sans devfreq, msm_devfreq_init échoue et le GPU
# reste à la fréquence choisie par défaut (table OPP 27/200/320 MHz du dtsi)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# Sans IOMMU, tous les tampons GPU/affichage viennent de la carveout VRAM de
# msm, prise dans le CMA : 1440x2560 en 32 bits = 14,7 Mo par tampon, 128 Mo
# s'épuisent sous Phosh (« could not get pages: -28 »). CMA 512 Mo, vram=384m
# (modprobe.d du paquet device).
CONFIG_CMA_SIZE_MBYTES=512
# Bridage thermique du GPU par devfreq (zones gpu-top / gpu-bottom du DTS) :
# indispensable avec les fréquences d'Android (jusqu'à 578 MHz)
CONFIG_DEVFREQ_THERMAL=y
# Fréquence des Krait (patches 0012-0015, nœuds du DTS), tout intégré au
# noyau : les cœurs montent en fréquence dès le démarrage du noyau, sans
# attendre le chargement des modules. Pour désactiver le changement de
# fréquence : « initcall_blacklist=qcom_cpufreq_init » sur la ligne append.
CONFIG_QCOM_HFPLL=y
CONFIG_KRAITCC=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_CPU_THERMAL=y
# schedutil : suit la charge du planificateur, plus réactif que conservative
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
