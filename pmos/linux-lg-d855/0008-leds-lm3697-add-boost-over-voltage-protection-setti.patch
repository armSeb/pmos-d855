From: armSeb <armSeb@users.noreply.github.com>
Subject: [PATCH] leds: lm3697: add boost over-voltage protection setting

The LM3697 boost OVP defaults to 16 V. On the LG G3 (two strings driven
from HVLED1/HVLED2) that is too low: the boost stays in over-voltage
protection and the backlight never lights, although the control bank is
enabled with a non-zero brightness. The vendor driver writes 0x02 to the
boost control register (0x1a), i.e. a 24 V OVP.

Add an optional "ti,ovp-microvolt" property (16, 24, 32 or 40 V),
written to the boost control register at init.

diff --git a/drivers/leds/leds-lm3697.c b/drivers/leds/leds-lm3697.c
index 7ad232780..af6860962 100644
--- a/drivers/leds/leds-lm3697.c
+++ b/drivers/leds/leds-lm3697.c
@@ -24,6 +24,7 @@
 #define LM3697_CTRL_A_B_BRT_CFG		0x16
 #define LM3697_CTRL_A_FS_CURR_CFG	0x17
 #define LM3697_CTRL_B_FS_CURR_CFG	0x18
+#define LM3697_BOOST_CTL		0x1a
 #define LM3697_PWM_CFG			0x1c
 #define LM3697_CTRL_A_BRT_LSB		0x20
 #define LM3697_CTRL_A_BRT_MSB		0x21
@@ -88,6 +89,7 @@ struct lm3697 {
 
 	int bank_cfg;
 	int num_banks;
+	int boost_ctl;
 
 	struct lm3697_led leds[] __counted_by(num_banks);
 };
@@ -190,6 +192,17 @@ static int lm3697_init(struct lm3697 *priv)
 	if (ret)
 		dev_err(dev, "Cannot write OUTPUT config\n");
 
+	/*
+	 * The boost OVP defaults to 16 V, too low for longer LED strings: the
+	 * boost then stays in over-voltage protection and the LEDs stay off.
+	 */
+	if (priv->boost_ctl >= 0) {
+		ret = regmap_write(priv->regmap, LM3697_BOOST_CTL,
+				   priv->boost_ctl);
+		if (ret)
+			dev_err(dev, "Cannot write boost control\n");
+	}
+
 	for (i = 0; i < priv->num_banks; i++) {
 		led = &priv->leds[i];
 		ret = ti_lmu_common_set_ramp(&led->lmu_data);
@@ -207,6 +220,7 @@ static int lm3697_probe_dt(struct lm3697 *priv)
 	int ret = -EINVAL;
 	int control_bank;
 	size_t i = 0;
+	u32 ovp;
 	int j;
 
 	priv->enable_gpio = devm_gpiod_get_optional(dev, "enable",
@@ -219,6 +233,21 @@ static int lm3697_probe_dt(struct lm3697 *priv)
 	if (IS_ERR(priv->regulator))
 		priv->regulator = NULL;
 
+	/* optional boost over-voltage protection: 16, 24, 32 or 40 V */
+	priv->boost_ctl = -1;
+	if (!device_property_read_u32(dev, "ti,ovp-microvolt", &ovp)) {
+		switch (ovp) {
+		case 16000000:
+		case 24000000:
+		case 32000000:
+		case 40000000:
+			priv->boost_ctl = ((ovp / 8000000) - 2) << 1;
+			break;
+		default:
+			dev_warn(dev, "unsupported ti,ovp-microvolt %u\n", ovp);
+		}
+	}
+
 	device_for_each_child_node_scoped(dev, child) {
 		struct led_init_data init_data = {};
 
