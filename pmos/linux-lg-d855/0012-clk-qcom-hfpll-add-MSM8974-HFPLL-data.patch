From: armSeb <armSeb@users.noreply.github.com>
Subject: [PATCH] clk: qcom: hfpll: add MSM8974 data

The "qcom,msm8974-hfpll" compatible is documented in the bindings but
the driver does not know it: MSM8974 boards would have to use the
deprecated "qcom,hfpll", which maps to the qcs404 data.

The MSM8974 Krait and L2 HFPLLs are the same PLLs, but the downstream
msm8974 kernel programs a different configuration value
(qcom,hfpll-config-val = <0x04d0405d>). Add MSM8974 data with it.

Signed-off-by: armSeb <armSeb@users.noreply.github.com>
---
diff --git a/drivers/clk/qcom/hfpll.c b/drivers/clk/qcom/hfpll.c
index b0b0cb074..aae9d6bcf 100644
--- a/drivers/clk/qcom/hfpll.c
+++ b/drivers/clk/qcom/hfpll.c
@@ -32,6 +32,28 @@ static const struct hfpll_data qcs404 = {
 	.max_rate = 2900000000UL,
 };
 
+/*
+ * MSM8974 Krait and L2 HFPLLs: the qcs404 data above, with the configuration
+ * value of the downstream msm8974 kernel (qcom,hfpll-config-val).
+ */
+static const struct hfpll_data msm8974 = {
+	.mode_reg = 0x00,
+	.l_reg = 0x04,
+	.m_reg = 0x08,
+	.n_reg = 0x0c,
+	.user_reg = 0x10,
+	.config_reg = 0x14,
+	.config_val = 0x4d0405d,
+	.status_reg = 0x1c,
+	.lock_bit = 16,
+
+	.user_val = 0x8,
+	.user_vco_mask = 0x100000,
+	.low_vco_max_rate = 1248000000,
+	.min_rate = 537600000UL,
+	.max_rate = 2900000000UL,
+};
+
 static const struct hfpll_data msm8976_a53 = {
 	.mode_reg = 0x00,
 	.l_reg = 0x04,
@@ -84,6 +106,7 @@ static const struct hfpll_data msm8976_cci = {
 };
 
 static const struct of_device_id qcom_hfpll_match_table[] = {
+	{ .compatible = "qcom,msm8974-hfpll", .data = &msm8974 },
 	{ .compatible = "qcom,msm8976-hfpll-a53", .data = &msm8976_a53 },
 	{ .compatible = "qcom,msm8976-hfpll-a72", .data = &msm8976_a72 },
 	{ .compatible = "qcom,msm8976-hfpll-cci", .data = &msm8976_cci },
