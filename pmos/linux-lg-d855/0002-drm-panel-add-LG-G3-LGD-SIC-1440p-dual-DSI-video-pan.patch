index 95890514a..d029095f9 100644
--- a/drivers/gpu/drm/panel/msm8974-generated/Kconfig
+++ b/drivers/gpu/drm/panel/msm8974-generated/Kconfig
@@ -20,4 +20,12 @@ config DRM_PANEL_SONY_LEO_NOVATEK_LGD
 	default DRM_PANEL_MSM8974_GENERATED
 	select DRM_KMS_HELPER
 
+config DRM_PANEL_LGE_G3_LGD_SIC
