diff --git a/drivers/gpu/drm/panel/msm8974-generated/panel-lge-g3-lgd-sic.c b/drivers/gpu/drm/panel/msm8974-generated/panel-lge-g3-lgd-sic.c
new file mode 100644
index 000000000..769649da0
--- /dev/null
+++ b/drivers/gpu/drm/panel/msm8974-generated/panel-lge-g3-lgd-sic.c
@@ -0,0 +1,489 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LG G3 (D855) 1440x2560 LGD "SIC" video mode panel, driven over two DSI
+ * links (left half on DSI0, right half on DSI1, 720x2560 each).
+ *
+ * Init/off sequences, timings and power-up order taken from the vendor
+ * device tree (msm8974pro-lge-panel.dtsi, LineageOS android_kernel_lge_g3):
+ *   Copyright (c) 2012, Code Aurora Forum. All rights reserved.
+ * Structure follows the linux-mdss-dsi-panel-driver-generator output and
+ * the dual DSI handling of panel-novatek-nt35950.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+static const char * const lgd_sic_supply_names[] = {
+	"vdd",	/* PM8941 L10, 1.8 V (downstream "vdd") */
+	"vsp",	/* TPS65132 positive output (+5.5 V) */
+	"vsn",	/* TPS65132 negative output (-5.5 V) */
+};
+
+struct lgd_sic {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi[2];
+	struct regulator_bulk_data supplies[ARRAY_SIZE(lgd_sic_supply_names)];
+	struct gpio_desc *reset_gpio;
+	bool dsv_cycled;
+};
+
+static inline struct lgd_sic *to_lgd_sic(struct drm_panel *panel)
+{
+	return container_of(panel, struct lgd_sic, panel);
+}
+
+/*
+ * Bring-up aid: keep the panel as the bootloader left it (powered, out of
+ * reset, initialized) on the first prepare, without resetting it or sending
+ * the init sequence. Tells a video-path problem from a panel-init problem.
+ */
+static bool debug_reads;
+module_param(debug_reads, bool, 0644);
+MODULE_PARM_DESC(debug_reads, "read back DCS registers around the init sequence");
+
+static bool keep_init;
+module_param(keep_init, bool, 0644);
+MODULE_PARM_DESC(keep_init, "keep the bootloader panel state on first prepare");
+
+/*
+ * Bring-up aid: which parts of the power-up sequence prepare() runs, to
+ * bisect the panel init. keep_init=1 is init_steps=0 for the first prepare.
+ * The DSV power cycle leaves the panel black: off by default (14).
+ */
+#define LGD_SIC_STEP_DSV_CYCLE	BIT(0)	/* switch VSP/VSN off and on once */
+#define LGD_SIC_STEP_RESET	BIT(1)	/* hold reset during power-up */
+#define LGD_SIC_STEP_TABLE	BIT(2)	/* vendor register table */
+#define LGD_SIC_STEP_ON		BIT(3)	/* sleep out + display on */
+#define LGD_SIC_STEP_HS		BIT(4)	/* send the commands in HS mode */
+#define LGD_SIC_STEPS_DEFAULT	(LGD_SIC_STEP_RESET | LGD_SIC_STEP_TABLE | LGD_SIC_STEP_ON)
+
+static unsigned int init_steps = LGD_SIC_STEPS_DEFAULT;
+module_param(init_steps, uint, 0644);
+MODULE_PARM_DESC(init_steps,
+		 "power-up steps: 1 DSV cycle, 2 reset, 4 table, 8 sleep out/display on, 16 HS commands (default 14)");
+
+/*
+ * Downstream uses "broadcast mode": the same commands go to both links.
+ * Send them on each link in turn.
+ */
+static void lgd_sic_on_link(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0xac);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb1, 0x47, 0xf0, 0x80, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x77, 0x28, 0x27);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x0f, 0x12, 0x22, 0x20, 0x00,
+				     0xa0);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb4, 0x13, 0x10, 0x10, 0x0a, 0x0a,
+				     0x0a, 0x0a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb5, 0x30, 0x26, 0x1a, 0x1a, 0x10,
+				     0x10, 0x40, 0x10, 0x05);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb7, 0x62, 0x01, 0x3f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc0, 0x03, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc1, 0x22, 0x80, 0xf0, 0x01, 0xcf);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc2, 0x22);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc3, 0x06, 0x88, 0x0c, 0x00, 0x1b,
+				     0x1b);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc4, 0x47, 0x0c, 0x0c);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc5, 0x41, 0x81, 0x05, 0x05, 0x59,
+				     0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xca, 0x20, 0xb9);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc9, 0x3f);
+	/* Gamma (identical for all six registers) */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd0, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd1, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd3, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd4, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd5, 0x03, 0x30, 0x35, 0x55, 0x22,
+				     0x34, 0x0f, 0x06, 0x51, 0x33, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xe9, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb6, 0x00, 0x00);
+	/* Panel-side brightness at max, backlight is the LM3697 */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0xff);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x5e, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x2c);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb8, 0x11, 0x11, 0x11, 0x38, 0x00,
+				     0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x81);
+	/* Image enhancement ("sharpening", 0x33 = default on) */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0x33);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf1, 0x00, 0x00, 0x02, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf2, 0x01, 0x00, 0x40);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf3, 0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf4, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf5, 0x01, 0x00, 0x61);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf6, 0x03, 0x00, 0x61);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf7, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf8, 0x40, 0x40, 0x40, 0x40, 0x40,
+				     0x40, 0x40, 0x40, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf9, 0x40, 0x40, 0x40, 0x40, 0x40,
+				     0x40, 0x40, 0x40, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfa, 0x40, 0x40, 0x40, 0x40, 0x40,
+				     0x40, 0x40, 0x40, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00);
+}
+
+static int lgd_sic_on(struct lgd_sic *ctx, unsigned int steps)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { };
+	int i;
+
+	if (steps & LGD_SIC_STEP_HS)
+		for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++)
+			ctx->dsi[i]->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (steps & LGD_SIC_STEP_TABLE) {
+		for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+			dsi_ctx.dsi = ctx->dsi[i];
+			lgd_sic_on_link(&dsi_ctx);
+		}
+	}
+
+	if (steps & LGD_SIC_STEP_ON) {
+		for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+			dsi_ctx.dsi = ctx->dsi[i];
+			mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+		}
+		mipi_dsi_msleep(&dsi_ctx, 120);
+
+		for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+			dsi_ctx.dsi = ctx->dsi[i];
+			mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++)
+		ctx->dsi[i]->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
+static int lgd_sic_off(struct lgd_sic *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+		dsi_ctx.dsi = ctx->dsi[i];
+		ctx->dsi[i]->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	}
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+		dsi_ctx.dsi = ctx->dsi[i];
+		mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	}
+	mipi_dsi_msleep(&dsi_ctx, 80);
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++)
+		ctx->dsi[i]->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * Bring-up aid: read back the DCS power mode (expected 0x9c: booster on,
+ * sleep out, normal mode, display on). In synchronized bonded mode msm only
+ * triggers transfers from the second link, so read through it.
+ */
+static void lgd_sic_dump_power_mode(struct lgd_sic *ctx, const char *when)
+{
+	/*
+	 * 0x0a power mode, 0x0b address mode, 0x0c pixel format, 0x0e signal
+	 * mode, 0x52/0x54 brightness/control (written 0xff/0x2c by the init
+	 * sequence), 0xda-0xdc ID. Shows whether writes reach the panel.
+	 */
+	static const u8 regs[] = { 0x0a, 0x0b, 0x0c, 0x0e, 0x52, 0x54,
+				   0xda, 0xdb, 0xdc };
+	char buf[160];
+	int i, l, n, ret;
+	u8 val;
+
+	if (!debug_reads)
+		return;
+
+	for (l = 0; l < ARRAY_SIZE(ctx->dsi); l++) {
+		n = 0;
+		for (i = 0; i < ARRAY_SIZE(regs); i++) {
+			val = 0;
+			ret = mipi_dsi_dcs_read(ctx->dsi[l], regs[i], &val, 1);
+			if (ret == 1)
+				n += scnprintf(buf + n, sizeof(buf) - n,
+					       " %02x=%02x", regs[i], val);
+			else
+				n += scnprintf(buf + n, sizeof(buf) - n,
+					       " %02x:err%d", regs[i], ret);
+		}
+		dev_info(&ctx->dsi[l]->dev, "DSI%d %s:%s\n", l, when, buf);
+	}
+}
+
+static int lgd_sic_prepare(struct drm_panel *panel)
+{
+	struct lgd_sic *ctx = to_lgd_sic(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	struct regulator *vdd = ctx->supplies[0].consumer;
+	struct regulator *vsp = ctx->supplies[1].consumer;
+	struct regulator *vsn = ctx->supplies[2].consumer;
+	unsigned int steps = init_steps;
+	int ret;
+
+	if (keep_init) {
+		keep_init = false;
+		steps = 0;
+		dev_info(dev, "keeping the bootloader panel state\n");
+	}
+	dev_info(dev, "power-up steps %#x\n", steps);
+
+	/* Hold the panel in reset while its rails come up. */
+	if (steps & LGD_SIC_STEP_RESET)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	ret = regulator_enable(vdd);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable vdd: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * The bootloader leaves the DSV (TPS65132) outputs on, but the
+	 * regulator framework starts with them "off": switch them on and off
+	 * once so the panel gets a real power cycle the first time.
+	 */
+	if ((steps & LGD_SIC_STEP_DSV_CYCLE) && !ctx->dsv_cycled) {
+		if (!regulator_enable(vsn))
+			regulator_disable(vsn);
+		if (!regulator_enable(vsp))
+			regulator_disable(vsp);
+		msleep(20);
+	}
+	ctx->dsv_cycled = true;
+
+	/*
+	 * Vendor order (mdss_dsi_panel_reset, LG): VSP, 5 ms, reset released
+	 * (rst-seq <1 5>), then VSN; output voltages reprogrammed after each
+	 * enable since the TPS65132 may lose them while disabled. With the
+	 * rails already up (bootloader), the enables change nothing.
+	 */
+	ret = regulator_enable(vsp);
+	if (ret < 0)
+		goto err_vdd;
+	usleep_range(500, 1000);
+	regulator_sync_voltage(vsp);
+	usleep_range(5000, 6000);
+
+	if (steps & LGD_SIC_STEP_RESET) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+		usleep_range(5000, 6000);
+	}
+
+	ret = regulator_enable(vsn);
+	if (ret < 0)
+		goto err_vsp;
+	usleep_range(500, 1000);
+	regulator_sync_voltage(vsn);
+	usleep_range(10000, 11000);
+
+	if (!(steps & (LGD_SIC_STEP_TABLE | LGD_SIC_STEP_ON))) {
+		lgd_sic_dump_power_mode(ctx, "kept");
+		return 0;
+	}
+
+	lgd_sic_dump_power_mode(ctx, "after power-up");
+
+	ret = lgd_sic_on(ctx, steps);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		goto err_vsn;
+	}
+
+	lgd_sic_dump_power_mode(ctx, "after init");
+
+	return 0;
+
+err_vsn:
+	regulator_disable(vsn);
+err_vsp:
+	regulator_disable(vsp);
+err_vdd:
+	regulator_disable(vdd);
+	return ret;
+}
+
+static int lgd_sic_unprepare(struct drm_panel *panel)
+{
+	struct lgd_sic *ctx = to_lgd_sic(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	int ret;
+
+	ret = lgd_sic_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supplies[2].consumer);
+	regulator_disable(ctx->supplies[1].consumer);
+	regulator_disable(ctx->supplies[0].consumer);
+
+	return 0;
+}
+
+/*
+ * Full panel mode. In bonded DSI mode the MSM DSI host halves the
+ * horizontal timings, so each link gets the vendor 720-pixel timings
+ * (HFP 12, HSW 12, HBP 40).
+ */
+static const struct drm_display_mode lgd_sic_mode = {
+	.clock = (1440 + 24 + 24 + 80) * (2560 + 5 + 1 + 5) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 24,
+	.hsync_end = 1440 + 24 + 24,
+	.htotal = 1440 + 24 + 24 + 80,
+	.vdisplay = 2560,
+	.vsync_start = 2560 + 5,
+	.vsync_end = 2560 + 5 + 1,
+	.vtotal = 2560 + 5 + 1 + 5,
+	.width_mm = 68,
+	.height_mm = 120,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int lgd_sic_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &lgd_sic_mode);
+}
+
+static const struct drm_panel_funcs lgd_sic_panel_funcs = {
+	.prepare = lgd_sic_prepare,
+	.unprepare = lgd_sic_unprepare,
+	.get_modes = lgd_sic_get_modes,
+};
+
+static int lgd_sic_probe(struct mipi_dsi_device *dsi)
+{
+	const struct mipi_dsi_device_info info = {
+		.type = "lgd-sic-dsi1",
+		.channel = 0,
+		.node = NULL,
+	};
+	struct device *dev = &dsi->dev;
+	struct mipi_dsi_host *dsi1_host;
+	struct device_node *dsi1;
+	struct lgd_sic *ctx;
+	int i, ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct lgd_sic, panel,
+				   &lgd_sic_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++)
+		ctx->supplies[i].supply = lgd_sic_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	/* Keep the panel as the bootloader left it until prepare() */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	/* Right half: DSI1, found through port@1 of the panel node */
+	dsi1 = of_graph_get_remote_node(dev->of_node, 1, -1);
+	if (!dsi1)
+		return dev_err_probe(dev, -ENODEV, "Cannot get DSI1 node\n");
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER, "Cannot get DSI1 host\n");
+
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host, &info);
+	if (IS_ERR(ctx->dsi[1]))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]),
+				     "Cannot register DSI1 device\n");
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
+		/*
+		 * non_burst_sync_event, init commands in LP mode. The clock
+		 * lane must stay in HS (continuous clock): the vendor DT sets
+		 * qcom,mdss-dsi-lane-hs = <1>, and the bootloader sets
+		 * DSI_LANE_CTRL.CLKLN_HS_FORCE_REQUEST. With a non-continuous
+		 * clock, video is sent but the panel stays black.
+		 */
+		ctx->dsi[i]->mode_flags = MIPI_DSI_MODE_VIDEO |
+					  MIPI_DSI_MODE_LPM;
+
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0) {
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret,
+					     "Cannot attach to DSI%d host\n", i);
+		}
+	}
+
+	return 0;
+}
+
+static void lgd_sic_remove(struct mipi_dsi_device *dsi)
+{
+	struct lgd_sic *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id lgd_sic_of_match[] = {
+	{ .compatible = "lge,g3-panel-lgd-sic" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lgd_sic_of_match);
+
+static struct mipi_dsi_driver lgd_sic_driver = {
+	.probe = lgd_sic_probe,
+	.remove = lgd_sic_remove,
+	.driver = {
+		.name = "panel-lge-g3-lgd-sic",
+		.of_match_table = lgd_sic_of_match,
+	},
+};
+module_mipi_dsi_driver(lgd_sic_driver);
+
+MODULE_DESCRIPTION("DRM driver for the LG G3 LGD SIC 1440p dual DSI video panel");
+MODULE_LICENSE("GPL");
