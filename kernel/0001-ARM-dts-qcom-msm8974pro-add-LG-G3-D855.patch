From 54e248d248ce2c7b5e1ae4f36f41cd1932a30add Mon Sep 17 00:00:00 2001
From: armSeb <armSeb@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:59:46 +0100
Subject: [PATCH] ARM: dts: qcom: msm8974pro: add LG G3 (D855) bring-up
 skeleton

Initial device tree for the international LG G3 (D855, MSM8974AC).

Enabled: eMMC, microSD, USB peripheral/OTG, volume keys, bq24296
charger, MAX17048 fuel gauge, Synaptics S3528 touchscreen (RMI4),
BCM4339 WiFi over SDIO.

Not yet: dual-DSI LGD SIC panel, LM3697 backlight, TPS65132 DSV,
Bluetooth (BLSP1 UART5), audio, modem/ADSP remoteprocs, sensors.
---
 arch/arm/boot/dts/qcom/Makefile               |   1 +
 .../dts/qcom/qcom-msm8974pro-lge-d855.dts     | 668 ++++++++++++++++++
 2 files changed, 669 insertions(+)
 create mode 100644 arch/arm/boot/dts/qcom/qcom-msm8974pro-lge-d855.dts

diff --git a/arch/arm/boot/dts/qcom/Makefile b/arch/arm/boot/dts/qcom/Makefile
index 892171a..dcb674c 100644
--- a/arch/arm/boot/dts/qcom/Makefile
+++ b/arch/arm/boot/dts/qcom/Makefile
@@ -52,6 +52,7 @@ dtb-$(CONFIG_ARCH_QCOM) += \
 	qcom-msm8974-sony-xperia-sirius.dtb \
 	qcom-msm8974pro-fairphone-fp2.dtb \
 	qcom-msm8974pro-htc-m8.dtb \
+	qcom-msm8974pro-lge-d855.dtb \
 	qcom-msm8974pro-oneplus-bacon.dtb \
 	qcom-msm8974pro-samsung-klte.dtb \
 	qcom-msm8974pro-samsung-kltechn.dtb \
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8974pro-lge-d855.dts b/arch/arm/boot/dts/qcom/qcom-msm8974pro-lge-d855.dts
new file mode 100644
index 0000000..b83982d
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/qcom-msm8974pro-lge-d855.dts
@@ -0,0 +1,668 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * LG G3 (international, D855) — MSM8974AC (Snapdragon 801), PM8841 + PM8941
+ *
+ * Squelette de bring-up. Base : qcom-msm8974-lge-nexus5-hammerhead.dts
+ * (même équipe LG, même architecture d'alimentation) et
+ * qcom-msm8974pro-sony-xperia-shinano-common.dtsi (microSD sur SDHC2,
+ * WiFi BCM4339 sur SDHC3).
+ *
+ * Câblage relevé dans le noyau downstream LineageOS (lineage-18.1) :
+ *   arch/arm/boot/dts/msm8974pro-g3-global_com/
+ *   arch/arm/boot/dts/msm8974pro-lge-common/
+ *   arch/arm/mach-msm/lge/wifi_bcm_lge.c, 8974ac-g3/board-8974-g3-*.c
+ *
+ * Les éléments marqués TODO ne sont pas encore validés sur le matériel.
+ */
+
+/dts-v1/;
+
+#include "qcom-msm8974pro.dtsi"
+#include "pm8841.dtsi"
+#include "pm8941.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+
+/ {
+	model = "LG G3 (D855)";
+	compatible = "lge,d855", "qcom,msm8974pro", "qcom,msm8974";
+	chassis-type = "handset";
+
+	/* downstream : qcom,msm-id = <194 118 0x10001> (ancien format 3 cellules) */
+	qcom,msm-id = <194 0x10001>;
+
+	aliases {
+		mmc0 = &sdhc_1;		/* eMMC */
+		mmc1 = &sdhc_2;		/* microSD */
+		mmc2 = &sdhc_3;		/* WiFi SDIO */
+		serial0 = &blsp1_uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+
+		/*
+		 * TODO (étape 2) : framebuffer laissé allumé par lk2nd.
+		 * Relever l'adresse depuis le shell de debug :
+		 *   busybox devmem 0xfd901414   (MDP5 RGB0 SSPP_SRC0_ADDR)
+		 * puis décommenter et ajouter le reserved-memory correspondant.
+		 *
+		 * framebuffer0: framebuffer@3200000 {
+		 *	compatible = "simple-framebuffer";
+		 *	reg = <0x03200000 (1440 * 2560 * 3)>;
+		 *	width = <1440>;
+		 *	height = <2560>;
+		 *	stride = <(1440 * 3)>;
+		 *	format = "r8g8b8";
+		 * };
+		 */
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio_keys_pin_a>;
+
+		key-volume-up {
+			label = "volume_up";
+			gpios = <&pm8941_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,input-type = <1>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+		};
+
+		key-volume-down {
+			label = "volume_down";
+			gpios = <&pm8941_gpios 3 GPIO_ACTIVE_LOW>;
+			linux,input-type = <1>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <15>;
+		};
+	};
+
+	/* Le LM3697 expose une LED : led-backlight en fait un backlight pour le panel */
+	backlight: backlight {
+		compatible = "led-backlight";
+		leds = <&lcd_led>;
+		default-brightness-level = <177>;
+		status = "disabled";	/* TODO : activer avec le panel */
+	};
+
+	/* Boost "bb_boost" piloté par PM8941 GPIO21 (identique au Nexus 5) */
+	vreg_boost: vreg-boost {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vreg-boost";
+		regulator-min-microvolt = <3150000>;
+		regulator-max-microvolt = <3150000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+
+		gpio = <&pm8941_gpios 21 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&boost_bypass_n_pin>;
+	};
+
+	vreg_vph_pwr: vreg-vph-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "vph-pwr";
+
+		regulator-min-microvolt = <3600000>;
+		regulator-max-microvolt = <3600000>;
+
+		regulator-always-on;
+	};
+
+	/* WL_REG_ON = TLMM 69 (wifi_bcm_lge.c : WLAN_POWER) */
+	vreg_wlan: wlan-regulator {
+		compatible = "regulator-fixed";
+
+		regulator-name = "wl-reg";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&tlmm 69 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_regulator_pin>;
+	};
+};
+
+/* Chargeur bq24296 + jauge MAX17048 (même bus et mêmes IRQ que le Nexus 5) */
+&blsp1_i2c1 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	charger: charger@6b {
+		compatible = "ti,bq24296";
+		reg = <0x6b>;
+		/* EXT_CHG_INT = PM8941 GPIO22 */
+		interrupts-extended = <&spmi_bus 0 0xd5 0 IRQ_TYPE_EDGE_FALLING>;
+
+		omit-battery-class;
+
+		usb_otg_vbus: usb-otg-vbus { };
+	};
+
+	fuel-gauge@36 {
+		compatible = "maxim,max17048";
+		reg = <0x36>;
+
+		/* TODO : rcomp downstream = 103 (cellule LGC) / 55 (TCD) */
+		maxim,double-soc;
+		maxim,rcomp = /bits/ 8 <103>;
+
+		interrupts-extended = <&tlmm 9 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fuelgauge_pin>;
+
+		maxim,alert-low-soc-level = <2>;
+	};
+};
+
+/* Tactile Synaptics S3528 (RMI4, F12) */
+&blsp1_i2c2 {
+	status = "okay";
+	clock-frequency = <355000>;
+
+	touchscreen@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+
+		interrupts-extended = <&tlmm 73 IRQ_TYPE_EDGE_FALLING>;
+		vdd-supply = <&pm8941_l22>;
+		vio-supply = <&pm8941_lvs3>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_pin>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+		};
+	};
+};
+
+/*
+ * Rétroéclairage LM3697 (0x36, HWEN = TLMM 91) et alimentation panel
+ * TPS65132 (0x3e, DSV_EN = TLMM 56 / 100). Désactivé tant que le panel
+ * n'a pas de driver.
+ */
+&blsp2_i2c5 {
+	status = "disabled";
+	clock-frequency = <400000>;
+
+	lm3697: led-controller@36 {
+		compatible = "ti,lm3697";
+		reg = <0x36>;
+
+		enable-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		lcd_led: led@0 {
+			reg = <0>;
+			led-sources = <0 1>;	/* HVLED1 + HVLED2 (rev >= c) */
+			ti,brightness-resolution = <2047>;
+			label = "lcd-backlight";
+		};
+	};
+
+	/* TODO : vérifier le binding et les tensions (+/-5,5 V typ.) */
+	dsv: pmic@3e {
+		compatible = "ti,tps65132";
+		reg = <0x3e>;
+
+		vpos: outp {
+			regulator-name = "lcd-vpos";
+			regulator-min-microvolt = <5500000>;
+			regulator-max-microvolt = <5500000>;
+			enable-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+		};
+
+		vneg: outn {
+			regulator-name = "lcd-vneg";
+			regulator-min-microvolt = <5500000>;
+			regulator-max-microvolt = <5500000>;
+			enable-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+
+/* UART de debug (points de test, non câblé en externe) */
+&blsp1_uart1 {
+	status = "okay";
+};
+
+/*
+ * TODO : Bluetooth BCM4339 sur BLSP1 UART5 (0xf9921000, GPIO 23-26),
+ * reset TLMM 41, host-wake TLMM 42, dev-wake TLMM 62.
+ * Le nœud UART n'existe pas encore dans qcom-msm8974.dtsi.
+ */
+
+/*
+ * TODO (étape 3) : panel LGD SIC 1440p, vidéo, *double DSI*
+ * (2 x 720x2560, 4 lanes chacun), reset = PM8941 GPIO19.
+ * Nécessite un driver généré (linux-mdss-dsi-panel-driver-generator)
+ * et le mode DSI couplé (qcom,dual-dsi-mode sur mdss_dsi0 + mdss_dsi1).
+ */
+
+&pm8941_gpios {
+	gpio_keys_pin_a: gpio-keys-active-state {
+		pins = "gpio2", "gpio3";
+		function = "normal";
+
+		bias-pull-up;
+		power-source = <PM8941_GPIO_S3>;
+	};
+
+	wlan_sleep_clk_pin: wl-sleep-clk-state {
+		pins = "gpio16";
+		function = "func2";
+
+		output-high;
+		power-source = <PM8941_GPIO_S3>;
+	};
+
+	/* PM8941 GPIO35 : OTG_EN du switch OVP (comme sur le Nexus 5) */
+	otg-hog {
+		gpio-hog;
+		gpios = <35 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "otg-gpio";
+	};
+};
+
+&remoteproc_adsp {
+	/* TODO : nécessite adsp.mdt depuis la partition modem */
+	status = "disabled";
+};
+
+&remoteproc_mss {
+	mss-supply = <&pm8841_s3>;
+	mx-supply = <&pm8841_s1>;
+	pll-supply = <&pm8941_l12>;
+	/* TODO : nécessite mba.mbn + modem.mdt depuis la partition modem */
+	status = "disabled";
+};
+
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8841-regulators";
+
+		pm8841_s1: s1 {
+			regulator-min-microvolt = <675000>;
+			regulator-max-microvolt = <1050000>;
+		};
+
+		pm8841_s3: s3 {
+			regulator-min-microvolt = <1050000>;
+			regulator-max-microvolt = <1050000>;
+		};
+	};
+
+	/* Valeurs reprises du Nexus 5, TODO : comparer au downstream */
+	regulators-1 {
+		compatible = "qcom,rpm-pm8941-regulators";
+
+		vdd_l1_l3-supply = <&pm8941_s1>;
+		vdd_l2_lvs1_2_3-supply = <&pm8941_s3>;
+		vdd_l4_l11-supply = <&pm8941_s1>;
+		vdd_l5_l7-supply = <&pm8941_s2>;
+		vdd_l6_l12_l14_l15-supply = <&pm8941_s2>;
+		vdd_l8_l16_l18_l19-supply = <&vreg_vph_pwr>;
+		vdd_l9_l10_l17_l22-supply = <&vreg_boost>;
+		vdd_l13_l20_l23_l24-supply = <&vreg_boost>;
+		vdd_l21-supply = <&vreg_boost>;
+
+		pm8941_s1: s1 {
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		pm8941_s2: s2 {
+			regulator-min-microvolt = <2150000>;
+			regulator-max-microvolt = <2150000>;
+			regulator-boot-on;
+		};
+
+		pm8941_s3: s3 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		pm8941_l1: l1 {
+			regulator-min-microvolt = <1225000>;
+			regulator-max-microvolt = <1225000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		pm8941_l2: l2 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+		};
+
+		pm8941_l3: l3 {
+			regulator-min-microvolt = <1225000>;
+			regulator-max-microvolt = <1225000>;
+		};
+
+		pm8941_l4: l4 {
+			regulator-min-microvolt = <1225000>;
+			regulator-max-microvolt = <1225000>;
+		};
+
+		pm8941_l5: l5 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8941_l6: l6 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-boot-on;
+		};
+
+		pm8941_l7: l7 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-boot-on;
+		};
+
+		pm8941_l8: l8 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8941_l9: l9 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2950000>;
+		};
+
+		pm8941_l10: l10 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2950000>;
+		};
+
+		pm8941_l11: l11 {
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+		};
+
+		pm8941_l12: l12 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		/* microSD VQMMC */
+		pm8941_l13: l13 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-boot-on;
+		};
+
+		pm8941_l14: l14 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8941_l15: l15 {
+			regulator-min-microvolt = <2050000>;
+			regulator-max-microvolt = <2050000>;
+		};
+
+		pm8941_l16: l16 {
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <2700000>;
+		};
+
+		pm8941_l17: l17 {
+			regulator-min-microvolt = <2850000>;
+			regulator-max-microvolt = <2850000>;
+		};
+
+		pm8941_l18: l18 {
+			regulator-min-microvolt = <2850000>;
+			regulator-max-microvolt = <2850000>;
+		};
+
+		pm8941_l19: l19 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3300000>;
+		};
+
+		/* eMMC VMMC */
+		pm8941_l20: l20 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-system-load = <200000>;
+			regulator-allow-set-load;
+			regulator-boot-on;
+		};
+
+		/* microSD VMMC */
+		pm8941_l21: l21 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-boot-on;
+		};
+
+		/* Tactile : le downstream le fixe à 3,3 V */
+		pm8941_l22: l22 {
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+		};
+
+		pm8941_l23: l23 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
+		pm8941_l24: l24 {
+			regulator-min-microvolt = <3075000>;
+			regulator-max-microvolt = <3075000>;
+			regulator-boot-on;
+		};
+
+		pm8941_lvs1: lvs1 {};
+		pm8941_lvs3: lvs3 {};
+	};
+};
+
+/* eMMC */
+&sdhc_1 {
+	status = "okay";
+
+	vmmc-supply = <&pm8941_l20>;
+	vqmmc-supply = <&pm8941_s3>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc1_on>;
+	pinctrl-1 = <&sdc1_off>;
+};
+
+/* microSD (rev_a1 et suivantes), détection carte TLMM 95 active basse */
+&sdhc_2 {
+	status = "okay";
+
+	vmmc-supply = <&pm8941_l21>;
+	vqmmc-supply = <&pm8941_l13>;
+
+	cd-gpios = <&tlmm 95 GPIO_ACTIVE_LOW>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_on>;
+	pinctrl-1 = <&sdc2_off>;
+};
+
+/* WiFi BCM4339 en SDIO, host-wake TLMM 44 */
+&sdhc_3 {
+	status = "okay";
+
+	max-frequency = <100000000>;
+	vmmc-supply = <&vreg_wlan>;
+	vqmmc-supply = <&pm8941_s3>;
+	non-removable;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdc3_on>;
+
+	wifi@1 {
+		compatible = "brcm,bcm4339-fmac", "brcm,bcm4329-fmac";
+		reg = <1>;
+
+		brcm,drive-strength = <10>;
+
+		interrupts-extended = <&tlmm 44 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wake";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_sleep_clk_pin>, <&wlan_hostwake_pin>;
+	};
+};
+
+&tlmm {
+	sdc1_on: sdc1-on-state {
+		clk-pins {
+			pins = "sdc1_clk";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		cmd-data-pins {
+			pins = "sdc1_cmd", "sdc1_data";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+	};
+
+	sdc2_on: sdc2-on-state {
+		clk-pins {
+			pins = "sdc2_clk";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		cmd-data-pins {
+			pins = "sdc2_cmd", "sdc2_data";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+
+		cd-pins {
+			pins = "gpio95";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	sdc3_on: sdc3-on-state {
+		clk-pins {
+			pins = "gpio40";
+			function = "sdc3";
+			drive-strength = <10>;
+			bias-disable;
+		};
+
+		cmd-pins {
+			pins = "gpio39";
+			function = "sdc3";
+			drive-strength = <10>;
+			bias-pull-up;
+		};
+
+		data-pins {
+			pins = "gpio35", "gpio36", "gpio37", "gpio38";
+			function = "sdc3";
+			drive-strength = <10>;
